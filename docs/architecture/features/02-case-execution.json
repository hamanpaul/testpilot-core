  "cards": [
    {
      "dot": "emerald",
      "title": "Core 只管生命週期與護欄",
      "items": [
        "Core 控制 retry 上限、timeout 遞增、hook 投影與語意不可變檢查。",
        "遇 command outcome unknown 或 terminal abort 立即停止重試與 teardown。"
      ]
    },
    {
      "dot": "amber",
      "title": "Plugin 擁有測試語意與裝置環境",
      "items": [
        "setup_env / verify_env / execute_step / evaluate() 全由 Plugin 實作。",
        "修復動作也在 Plugin 執行，Core 只把關修復後 verify_env gate。"
      ]
    },
    {
      "dot": "slate",
      "title": "Azure Agent 不得介入判定",
      "items": [
        "僅可做案前規劃與 opt-in Tier-2 環境修復計畫（無 tools、無權改判）。",
        "所有 attempt 紀錄皆寫入 reports/<RID>/agent_trace/<case>.json。"
      ]
    }
  ]
