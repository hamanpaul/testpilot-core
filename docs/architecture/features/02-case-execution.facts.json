{
  "schema_version": 1,
  "document_type": "feature-facts",
  "feature": {
    "id": "02-case-execution",
    "order": 2,
    "title": "單案與重試",
    "summary": "Core 控制每案的有界重試、timeout 遞增與 hook 投影；每個 attempt 交由 Domain Plugin 執行環境設定、步驟（含自選傳輸）、evaluate 判定與 teardown，並在重試間執行 Tier-1／Tier-2 環境修復與語意不變 gate。"
  },
  "repository": {
    "url": "https://github.com/hamanpaul/testpilot-core",
    "revision": "413d336e3a9c8b56bd4b94535eeab200f9f236aa"
  },
  "diagram_type": "sequence",
  "scope": {
    "includes": [
      "run_loop 逐案選 runner、可選 _plan_case 與 pre_case/post_case",
      "ExecutionEngine.execute_case_once：setup_env → verify_env → steps → evaluate → teardown",
      "on_failure / on_retry 間 Tier-1 與 opt-in Tier-2 環境修復、語意不變檢查與 unknown outcome fail-closed"
    ],
    "excludes": [
      "Plugin 內部的特定硬體命令實作（例如 serialwrap / SSH / ADB 呼叫細節）",
      "run 結束後的 log harvest 與報表輸出（見 03 收尾報表）"
    ]
  },
