  "cards": [
    {
      "dot": "emerald",
      "title": "能力閘門先於實機 I/O",
      "items": [
        "admit_run_capabilities 只檢查型別與屬性，不觸發裝置連線。",
        "strict 模式確認 capture context 與 role_plan digest 後才探測韌體版本。"
      ]
    },
    {
      "dot": "amber",
      "title": "三條執行分流",
      "items": [
        "Core run_loop：需要有 build_reports() 的 reporter，走完整的逐案重試管線。",
        "Custom Runner（僅 legacy）：完全自管執行；Skeleton：僅盤點案例不實測。"
      ]
    },
    {
      "dot": "slate",
      "title": "來源鎖定",
      "items": [
        "來源固定於 413d336e3a9c；點選參與者可檢視對應程式碼。",
        "支援滑鼠滾輪縮放與上方導覽列切換總覽／各階段流程。"
      ]
    }
  ]
